# Server Configuration
PORT=3000

# Database
MONGODB_URI=your_uri
# JWT Secrets (Generate strong random strings for production)
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_here
REFRESH_TOKEN_EXPIRY=10d

# CORS
CORS_ORIGIN=http://localhost:5173

# Email Configuration (for email verification and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# URLs
FORGOT_PASSWORD_URL=http://localhost:5173/reset-password
